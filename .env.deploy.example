# Variables del despliegue. Copiar a .env.deploy y rellenar antes de levantar.
#   cp .env.deploy.example .env.deploy
#
# IMPORTANTE: es .env.deploy, NO .env. El .env lo usa el frontend en
# desarrollo (VITE_API_URL) y se sobrescribiría.

# ===== Base de datos =====
DB_USER=multicatalogo
DB_PASSWORD=pon-aqui-una-clave-larga-y-aleatoria
DB_NAME=multicatalogo

# ===== Firma de los tokens JWT =====
# Generar con:  openssl rand -base64 48
JWT_SECRET=pon-aqui-un-secreto-largo-y-aleatorio

# ===== Dominio público del túnel =====
# El mismo que se configure en Cloudflare, con https://
PUBLIC_URL=https://multicatalogo.tudominio.com

# ===== Token del túnel de Cloudflare =====
# Panel de Cloudflare > Zero Trust > Networks > Tunnels > Create a tunnel
# Al crearlo, Cloudflare muestra el token; se copia aquí.
TUNNEL_TOKEN=pon-aqui-el-token-del-tunel
