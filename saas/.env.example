# Base de datos (la misma que usa el núcleo en Go)
DB_HOST=localhost
DB_PORT=5433
DB_USER=multicatalogo
DB_PASSWORD=multicatalogo
DB_NAME=multicatalogo

# DEBE ser el mismo secreto que firma los tokens en el backend Go
JWT_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria

# Orígenes permitidos por CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

APP_ENV=dev
PORT=8000
