# Conexión a PostgreSQL
DB_HOST=localhost
DB_PORT=5433
DB_USER=multicatalogo
DB_PASSWORD=multicatalogo
DB_NAME=multicatalogo

# Conexión a Redis (caché)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Puerto del servidor Fiber
APP_PORT=3000

# Firma de los tokens JWT (en producción debe ser un valor largo y secreto)
JWT_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria
# dev muestra el campo "details" en los errores; en producción se oculta
APP_ENV=dev

# Orígenes permitidos por CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173
